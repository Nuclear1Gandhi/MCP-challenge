{
  "name": "waypoint-challenge-mcp",
  "version": "1.0.0",
  "description": "MCP server for Waypoint Learning Special Education Challenge \u2014 lesson + IEP differentiation context",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "extract-data": "tsx scripts/extract-sample-data.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
